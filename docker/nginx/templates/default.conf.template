# Локальный CDN. Переменные ${CDN_*}/${S3_*}/${CORS_*} подставляет entrypoint образа nginx.
#
# /media/<key>       — превью и прокси (бакет производных) по ссылке, подписанной бэкендом:
#                      secure_link = md5(expires + uri + " " + secret). Кешируется кусками по 1 МБ,
#                      поэтому перемотка видео (Range) тоже идёт из кеша.
# /<originals>/<key> — presigned-загрузка и скачивание оригиналов: подпись проверяет хранилище,
#                      nginx лишь пробрасывает запрос, не буферизуя тело (файлы в десятки ГБ).

proxy_cache_path /var/cache/nginx/cdn levels=1:2 keys_zone=cdn:50m max_size=20g inactive=30d use_temp_path=off;

map $args $presigned {
    "~(^|&)X-Amz-Signature=" 1;
    default 0;
}

upstream rustfs {
    server rustfs:9000;
    keepalive 32;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 0;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /media/ {
        secure_link $arg_token,$arg_expires;
        secure_link_md5 "$secure_link_expires$uri ${CDN_SECRET}";

        # Подпись неверна — 403, ссылка просрочена — 410
        if ($secure_link = "") { return 403; }
        if ($secure_link = "0") { return 410; }

        rewrite ^/media/(.*)$ /${S3_RENDITIONS_BUCKET}/$1 break;

        proxy_pass http://rustfs;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host rustfs:9000;
        proxy_set_header Authorization "";

        slice 1m;
        proxy_set_header Range $slice_range;
        proxy_cache cdn;
        proxy_cache_key $uri$slice_range;
        proxy_cache_lock on;
        proxy_cache_valid 200 206 30d;
        proxy_cache_valid 403 404 1m;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;

        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;

        # Ссылка стабильна в окне подписи: в его пределах браузер берёт файл из своего кеша.
        # CORS нужен редактору и canvas
        add_header Cache-Control "private, max-age=3600" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location /${S3_ORIGINALS_BUCKET}/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "${CORS_ORIGIN}";
            add_header Access-Control-Allow-Methods "GET, HEAD, PUT";
            add_header Access-Control-Allow-Headers $http_access_control_request_headers;
            add_header Access-Control-Max-Age 86400;
            return 204;
        }
        if ($presigned = 0) { return 403; }

        proxy_pass http://rustfs;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Подпись включает Host: хранилище должно увидеть публичный адрес, которым подписан URL
        proxy_set_header Host $http_host;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Expose-Headers;
        add_header Access-Control-Allow-Origin "${CORS_ORIGIN}" always;
        add_header Access-Control-Expose-Headers "ETag" always;
    }

    location / {
        return 404;
    }
}
