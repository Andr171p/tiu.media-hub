# =====================================================================================================
# TIU Media Hub. Скопируйте в .env: значения рассчитаны на локальную разработку.
# Адреса — для запуска API/воркеров на хосте (uv run ...). В Docker адреса сервисов
# переопределяются в docker/app.yml.
# =====================================================================================================

# Модели: cpu — разработка; gpu — сервер с NVIDIA (CUDA-образы Infinity/Whisper + локальная VLM в Ollama)
COMPOSE_PROFILES=cpu

# --- API ---------------------------------------------------------------------------------------------
API_PORT=8000
API_CORS_ORIGINS='["http://localhost:5173"]'

# --- PostgreSQL --------------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USERNAME=dam
POSTGRES_PASSWORD=dam
POSTGRES_DB=dam
KEYCLOAK_DB_PASSWORD=keycloak

# --- RabbitMQ (taskiq) -------------------------------------------------------------------------------
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USERNAME=dam
RABBIT_PASSWORD=dam

# --- Хранилище (RustFS, S3) --------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
# Адрес, которым подписываются presigned URL: браузер ходит в хранилище через nginx
S3_PUBLIC_ENDPOINT_URL=http://localhost:8090
S3_ACCESS_KEY=dam
S3_SECRET_KEY=dam-dev-secret
S3_ORIGINALS_BUCKET=dam-originals
S3_RENDITIONS_BUCKET=dam-renditions

# --- CDN (nginx) -------------------------------------------------------------------------------------
CDN_PORT=8090
CDN_BASE_URL=http://localhost:8090
# Общий секрет бэкенда и nginx для подписи ссылок. В production — длинный случайный
CDN_SECRET=dev-cdn-secret-change-me
# Origin фронта для загрузки файлов через CDN (* — любой, только для разработки)
CDN_CORS_ORIGIN=*

# --- Keycloak ----------------------------------------------------------------------------------------
KEYCLOAK_PORT=8081
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/tiu-media-hub
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/tiu-media-hub/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=tiu-media-hub-api
KEYCLOAK_USER_CLIENT_IDS='["tiu-media-hub-web", "tiu-media-hub-dev"]'
KEYCLOAK_SERVICE_CLIENT_IDS='["tiu-media-hub-service"]'

# --- Порталы -----------------------------------------------------------------------------------------
# Подпись токенов посетителей, вошедших по паролю. В production — длинный случайный
PORTAL_SECRET=dev-portal-secret-change-me

# --- Поиск: Qdrant + Infinity (CLIP) -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
INFINITY_URL=http://localhost:7997
INFINITY_IMAGE_MODEL=openai/clip-vit-base-patch32
INFINITY_TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1

# --- Описания и теги (VLM, OpenAI-совместимый API) ---------------------------------------------------
# Разработка: AITunnel, дешёвая модель. Сервер (COMPOSE_PROFILES=gpu):
#   VISION_BASE_URL=http://ollama:11434/v1  VISION_API_KEY=  VISION_MODEL=qwen3-vl:4b
VISION_BASE_URL=https://api.aitunnel.ru/v1
VISION_API_KEY=
VISION_MODEL=gemini-2.5-flash-lite
OLLAMA_VISION_MODEL=qwen3-vl:4b

# --- Речь (Whisper ASR) ------------------------------------------------------------------------------
WHISPER_URL=http://localhost:9010
# base — быстро на CPU; на GPU — small/medium
WHISPER_MODEL=base

# --- Лица (OpenCV YuNet + SFace) ---------------------------------------------------------------------
# Локально модели скачиваются при первом использовании; в Docker они уже в образе
FACES_MODELS_DIR=.models

# --- Редактор ----------------------------------------------------------------------------------------
# Шрифты текста (в Docker — DejaVu из образа). На Windows, например:
# EDITOR_FONT_REGULAR=C:/Windows/Fonts/arial.ttf
# EDITOR_FONT_BOLD=C:/Windows/Fonts/arialbd.ttf
