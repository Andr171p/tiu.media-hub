# =====================================================================================================
# TIU Media Hub. Скопируйте в .env: значения ниже рассчитаны на локальную разработку.
# Адреса — для запуска API/воркеров на хосте (uv run ...). В Docker адреса сервисов
# переопределяются в docker/app.docker-compose.yml.
# =====================================================================================================

# --- API ---------------------------------------------------------------------------------------------
API_CORS_ORIGINS='["http://localhost:5173"]'

# --- PostgreSQL --------------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USERNAME=dam
POSTGRES_PASSWORD=dam
POSTGRES_DB=dam

# --- RabbitMQ (taskiq) -------------------------------------------------------------------------------
RABBIT_HOST=localhost
RABBIT_USERNAME=dam
RABBIT_PASSWORD=dam

# --- S3 (MinIO) --------------------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
# Адрес S3, по которому браузер загружает файлы: им подписываются presigned URL
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=dam
S3_SECRET_KEY=dam-dev-secret
S3_BUCKET=dam

# --- CDN (nginx) -------------------------------------------------------------------------------------
CDN_BASE_URL=http://localhost:8090
# Общий секрет бэкенда и nginx: подпись ссылок и доступ CDN к бакету. В production — длинный случайный
CDN_SECRET=dev-cdn-secret-change-me

# --- Keycloak ----------------------------------------------------------------------------------------
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/tiu-media-hub
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/tiu-media-hub/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=tiu-media-hub-api
KEYCLOAK_USER_CLIENT_IDS='["tiu-media-hub-web"]'
KEYCLOAK_SERVICE_CLIENT_IDS='["tiu-media-hub-service"]'

# --- Поиск: Qdrant + Infinity (SigLIP) ---------------------------------------------------------------
QDRANT_URL=http://localhost:6333
INFINITY_URL=http://localhost:7997
INFINITY_MODEL=google/siglip-base-patch16-256-multilingual
INFINITY_DIMENSIONS=768

# --- Обработка ---------------------------------------------------------------------------------------
# Шрифт текстового водяного знака (в Docker — DejaVu из образа). На Windows, например:
# PROCESSING_WATERMARK_FONT_PATH=C:/Windows/Fonts/arialbd.ttf
