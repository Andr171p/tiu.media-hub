{
  "realm": "tiu-media-hub",
  "enabled": true,
  "displayName": "TIU Media Hub",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru",
    "en"
  ],
  "defaultLocale": "ru",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 7200,
  "roles": {
    "client": {
      "tiu-media-hub-api": [
        {
          "name": "admin",
          "description": "Глобальный администратор DAM: доступ ко всем коллекциям и порталам"
        },
        {
          "name": "assets:read",
          "description": "Сервис: чтение любых активов через /api/service/v1"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "tiu-media-hub-web",
      "name": "TIU Media Hub Web",
      "description": "SPA: Authorization Code + PKCE S256, без секрета",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "dam-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "tiu-media-hub-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "tiu-media-hub-api",
      "name": "TIU Media Hub API",
      "description": "Resource server: владелец ролей API, входа нет",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "tiu-media-hub-service",
      "name": "TIU Media Hub Service",
      "description": "Пример доверенного сервиса (Client Credentials). Секрет только для разработки",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-service-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "dam-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "tiu-media-hub-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "tiu-media-hub-dev",
      "name": "TIU Media Hub Dev",
      "description": "Только для разработки: password grant для curl и интеграционных тестов. Удалить в production",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "dam-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "tiu-media-hub-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "tiu-media-hub-api": [
      {
        "client": "tiu-media-hub-web",
        "roles": [
          "admin"
        ]
      },
      {
        "client": "tiu-media-hub-service",
        "roles": [
          "assets:read"
        ]
      },
      {
        "client": "tiu-media-hub-dev",
        "roles": [
          "admin",
          "assets:read"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@tyuiu.ru",
      "firstName": "Администратор",
      "lastName": "DAM",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "clientRoles": {
        "tiu-media-hub-api": [
          "admin"
        ]
      }
    },
    {
      "username": "ivanov",
      "email": "ivanov@tyuiu.ru",
      "firstName": "Иван",
      "lastName": "Иванов",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "ivanov",
          "temporary": false
        }
      ]
    },
    {
      "username": "petrova",
      "email": "petrova@tyuiu.ru",
      "firstName": "Мария",
      "lastName": "Петрова",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "petrova",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-tiu-media-hub-service",
      "enabled": true,
      "serviceAccountClientId": "tiu-media-hub-service",
      "clientRoles": {
        "tiu-media-hub-api": [
          "assets:read"
        ]
      }
    }
  ]
}
