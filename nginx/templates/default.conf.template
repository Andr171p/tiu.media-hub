# CDN для производных (миниатюры, превью). Шаблон: переменные ${...} подставляет entrypoint образа nginx.
#
# Бакет закрыт. Объект отдаётся только по ссылке, подписанной бэкендом (secure_link: срок + md5),
# а MinIO отдаёт объект анонимно только этому прокси (политика бакета с условием aws:Referer).
# Объекты неизменяемы, поэтому кешируются по пути без подписи.

proxy_cache_path /var/cache/nginx/cdn levels=1:2 keys_zone=cdn:50m max_size=10g inactive=30d use_temp_path=off;

upstream minio {
    server ${MINIO_HOST};
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /media/ {
        secure_link $arg_token,$arg_expires;
        secure_link_md5 "$secure_link_expires$uri ${CDN_SECRET}";

        # Подпись неверна — 403, ссылка просрочена — 410
        if ($secure_link = "") { return 403; }
        if ($secure_link = "0") { return 410; }

        rewrite ^/media/(.*)$ /${S3_BUCKET}/$1 break;

        proxy_pass http://minio;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${MINIO_HOST};
        proxy_set_header Referer "cdn:${CDN_SECRET}";
        proxy_set_header Authorization "";

        proxy_cache cdn;
        proxy_cache_key $uri;
        proxy_cache_lock on;
        proxy_cache_valid 200 30d;
        proxy_cache_valid 403 404 1m;
        proxy_ignore_headers Set-Cookie;

        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        proxy_hide_header Set-Cookie;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header Strict-Transport-Security;

        # Ссылка живёт окно подписи: в его пределах браузер берёт файл из кеша.
        # CORS нужен редактору: превью рисуется на canvas
        add_header Cache-Control "private, max-age=3600" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location / {
        return 404;
    }
}
